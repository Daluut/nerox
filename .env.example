# Copy to .env.local and fill in. Never commit real values.

# Supabase project → Settings → API. The anon key is public by design;
# row-level security in supabase/migrations protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public URL of this app. Used in invitation links and auth email redirects.
# Must also be listed under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: turns on Nerox AI answers powered by Claude. Without it, Nerox AI
# answers from the built-in help guide. Keep this secret; it's only used on the server.
ANTHROPIC_API_KEY=
# Optional: which Claude model Nerox AI uses (defaults to claude-haiku-5-5).
NEROX_AI_MODEL=

# Set to "off" to disable live updates (e.g. if Realtime isn't enabled on your project).
NEXT_PUBLIC_REALTIME=on
